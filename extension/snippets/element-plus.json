{
  "Vue3 Element Search Table": {
    "prefix": "v3el-search-table",
    "body": [
      "<script setup lang=\"ts\">",
      "// Docs: https://element-plus.org/en-US/component/table.html",
      "import { ref, reactive } from 'vue'",
      "",
      "interface SearchForm {",
      "\t${1:keyword}: string",
      "\t${2:status}: string",
      "\t${3:date}: string[]",
      "}",
      "",
      "const searchForm = reactive<SearchForm>({",
      "\t${1:keyword}: '',",
      "\t${2:status}: '',",
      "\t${3:date}: []",
      "})",
      "",
      "const tableData = ref([])",
      "const loading = ref(false)",
      "const pagination = reactive({",
      "\ttotal: 0,",
      "\tcurrentPage: 1,",
      "\tpageSize: 10",
      "})",
      "",
      "const handleSearch = async () => {",
      "\ttry {",
      "\t\tloading.value = true",
      "\t\t// TODO: Implement search logic",
      "\t\tconst { data, total } = await fetchData({",
      "\t\t\t...searchForm,",
      "\t\t\tpage: pagination.currentPage,",
      "\t\t\tpageSize: pagination.pageSize",
      "\t\t})",
      "\t\ttableData.value = data",
      "\t\tpagination.total = total",
      "\t} finally {",
      "\t\tloading.value = false",
      "\t}",
      "}",
      "",
      "const handleReset = () => {",
      "\tsearchForm.${1:keyword} = ''",
      "\tsearchForm.${2:status} = ''",
      "\tsearchForm.${3:date} = []",
      "\tpagination.currentPage = 1",
      "\thandleSearch()",
      "}",
      "",
      "const handleSizeChange = (val: number) => {",
      "\tpagination.pageSize = val",
      "\thandleSearch()",
      "}",
      "",
      "const handleCurrentChange = (val: number) => {",
      "\tpagination.currentPage = val",
      "\thandleSearch()",
      "}",
      "</script>",
      "",
      "<template>",
      "\t<div class=\"search-table-container\">",
      "\t\t<!-- Search Form -->",
      "\t\t<el-form :model=\"searchForm\" inline>",
      "\t\t\t<el-form-item label=\"${4:Keyword}\">",
      "\t\t\t\t<el-input",
      "\t\t\t\t\tv-model=\"searchForm.${1:keyword}\"",
      "\t\t\t\t\tplaceholder=\"Please enter ${4:Keyword}\"",
      "\t\t\t\t\tclearable",
      "\t\t\t\t\t@keyup.enter=\"handleSearch\"",
      "\t\t\t\t/>",
      "\t\t\t</el-form-item>",
      "",
      "\t\t\t<el-form-item label=\"${5:Status}\">",
      "\t\t\t\t<el-select",
      "\t\t\t\t\tv-model=\"searchForm.${2:status}\"",
      "\t\t\t\t\tplaceholder=\"Please select ${5:Status}\"",
      "\t\t\t\t\tclearable",
      "\t\t\t\t>",
      "\t\t\t\t\t<el-option label=\"Option 1\" value=\"1\" />",
      "\t\t\t\t\t<el-option label=\"Option 2\" value=\"2\" />",
      "\t\t\t\t</el-select>",
      "\t\t\t</el-form-item>",
      "",
      "\t\t\t<el-form-item label=\"${6:Date}\">",
      "\t\t\t\t<el-date-picker",
      "\t\t\t\t\tv-model=\"searchForm.${3:date}\"",
      "\t\t\t\t\ttype=\"daterange\"",
      "\t\t\t\t\trange-separator=\"to\"",
      "\t\t\t\t\tstart-placeholder=\"Start Date\"",
      "\t\t\t\t\tend-placeholder=\"End Date\"",
      "\t\t\t\t/>",
      "\t\t\t</el-form-item>",
      "",
      "\t\t\t<el-form-item>",
      "\t\t\t\t<el-button type=\"primary\" @click=\"handleSearch\">",
      "\t\t\t\t\tSearch",
      "\t\t\t\t</el-button>",
      "\t\t\t\t<el-button @click=\"handleReset\">Reset</el-button>",
      "\t\t\t</el-form-item>",
      "\t\t</el-form>",
      "",
      "\t\t<!-- Table -->",
      "\t\t<el-table",
      "\t\t\tv-loading=\"loading\"",
      "\t\t\t:data=\"tableData\"",
      "\t\t\tborder",
      "\t\t\tstripe",
      "\t\t\tstyle=\"width: 100%\"",
      "\t\t>",
      "\t\t\t<el-table-column prop=\"id\" label=\"ID\" width=\"80\" />",
      "\t\t\t<el-table-column prop=\"name\" label=\"Name\" />",
      "\t\t\t<el-table-column prop=\"status\" label=\"Status\">",
      "\t\t\t\t<template #default=\"{ row }\">",
      "\t\t\t\t\t<el-tag :type=\"row.status === '1' ? 'success' : 'info'\">",
      "\t\t\t\t\t\t{{ row.status === '1' ? 'Active' : 'Disabled' }}",
      "\t\t\t\t\t</el-tag>",
      "\t\t\t\t</template>",
      "\t\t\t</el-table-column>",
      "\t\t\t<el-table-column prop=\"date\" label=\"Date\" width=\"160\" />",
      "\t\t\t<el-table-column label=\"Actions\" width=\"150\" fixed=\"right\">",
      "\t\t\t\t<template #default=\"{ row }\">",
      "\t\t\t\t\t<el-button link type=\"primary\" @click=\"handleEdit(row)\">",
      "\t\t\t\t\t\tEdit",
      "\t\t\t\t\t</el-button>",
      "\t\t\t\t\t<el-button link type=\"danger\" @click=\"handleDelete(row)\">",
      "\t\t\t\t\t\tDelete",
      "\t\t\t\t\t</el-button>",
      "\t\t\t\t</template>",
      "\t\t\t</el-table-column>",
      "\t\t</el-table>",
      "",
      "\t\t<!-- Pagination -->",
      "\t\t<div class=\"pagination-container\">",
      "\t\t\t<el-pagination",
      "\t\t\t\tv-model:current-page=\"pagination.currentPage\"",
      "\t\t\t\tv-model:page-size=\"pagination.pageSize\"",
      "\t\t\t\t:page-sizes=\"[10, 20, 50, 100]\"",
      "\t\t\t\t:total=\"pagination.total\"",
      "\t\t\t\tlayout=\"total, sizes, prev, pager, next, jumper\"",
      "\t\t\t\t@size-change=\"handleSizeChange\"",
      "\t\t\t\t@current-change=\"handleCurrentChange\"",
      "\t\t\t/>",
      "\t\t</div>",
      "\t</div>",
      "</template>",
      "",
      "<style scoped>",
      ".search-table-container {",
      "\tpadding: 20px;",
      "}",
      "",
      ".pagination-container {",
      "\tmargin-top: 20px;",
      "\tdisplay: flex;",
      "\tjustify-content: flex-end;",
      "}",
      "</style>"
    ],
    "description": "Element Plus Search Table Component"
  },
  "Vue3 Element Form": {
    "prefix": "v3el-form",
    "body": [
      "<script setup lang=\"ts\">",
      "import { reactive, ref } from 'vue'",
      "",
      "interface FormData {",
      "\t${1:name}: string",
      "\t${2:email}: string",
      "\t${3:phone}: string",
      "\t${4:status}: string",
      "\t${5:remark}: string",
      "}",
      "",
      "const formRef = ref()",
      "const formData = reactive<FormData>({",
      "\t${1:name}: '',",
      "\t${2:email}: '',",
      "\t${3:phone}: '',",
      "\t${4:status}: '',",
      "\t${5:remark}: ''",
      "})",
      "",
      "const rules = {",
      "\t${1:name}: [{ required: true, message: 'Please enter name', trigger: 'blur' }],",
      "\t${2:email}: [",
      "\t\t{ required: true, message: 'Please enter email', trigger: 'blur' },",
      "\t\t{ type: 'email', message: 'Please enter a valid email address', trigger: 'blur' }",
      "\t],",
      "\t${3:phone}: [{ required: true, message: 'Please enter phone number', trigger: 'blur' }],",
      "\t${4:status}: [{ required: true, message: 'Please select status', trigger: 'change' }]",
      "}",
      "",
      "const handleSubmit = async () => {",
      "\tif (!formRef.value) return",
      "\tawait formRef.value.validate((valid: boolean) => {",
      "\t\tif (valid) {",
      "\t\t\tconsole.log('submit:', formData)",
      "\t\t\t// TODO: Implement submit logic",
      "\t\t}",
      "\t})",
      "}",
      "",
      "const handleReset = () => {",
      "\tif (!formRef.value) return",
      "\tformRef.value.resetFields()",
      "}",
      "</script>",
      "",
      "<template>",
      "\t<el-form",
      "\t\tref=\"formRef\"",
      "\t\t:model=\"formData\"",
      "\t\t:rules=\"rules\"",
      "\t\tlabel-width=\"100px\"",
      "\t>",
      "\t\t<el-form-item label=\"Name\" prop=\"${1:name}\">",
      "\t\t\t<el-input v-model=\"formData.${1:name}\" placeholder=\"Please enter name\" />",
      "\t\t</el-form-item>",
      "",
      "\t\t<el-form-item label=\"Email\" prop=\"${2:email}\">",
      "\t\t\t<el-input v-model=\"formData.${2:email}\" placeholder=\"Please enter email\" />",
      "\t\t</el-form-item>",
      "",
      "\t\t<el-form-item label=\"Phone\" prop=\"${3:phone}\">",
      "\t\t\t<el-input v-model=\"formData.${3:phone}\" placeholder=\"Please enter phone number\" />",
      "\t\t</el-form-item>",
      "",
      "\t\t<el-form-item label=\"Status\" prop=\"${4:status}\">",
      "\t\t\t<el-select v-model=\"formData.${4:status}\" placeholder=\"Please select status\">",
      "\t\t\t\t<el-option label=\"Active\" value=\"1\" />",
      "\t\t\t\t<el-option label=\"Disabled\" value=\"0\" />",
      "\t\t\t</el-select>",
      "\t\t</el-form-item>",
      "",
      "\t\t<el-form-item label=\"Remark\" prop=\"${5:remark}\">",
      "\t\t\t<el-input",
      "\t\t\t\tv-model=\"formData.${5:remark}\"",
      "\t\t\t\ttype=\"textarea\"",
      "\t\t\t\t:rows=\"3\"",
      "\t\t\t\tplaceholder=\"Please enter remark\"",
      "\t\t\t/>",
      "\t\t</el-form-item>",
      "",
      "\t\t<el-form-item>",
      "\t\t\t<el-button type=\"primary\" @click=\"handleSubmit\">Submit</el-button>",
      "\t\t\t<el-button @click=\"handleReset\">Reset</el-button>",
      "\t\t</el-form-item>",
      "\t</el-form>",
      "</template>"
    ],
    "description": "Element Plus Form Template"
  }
} 