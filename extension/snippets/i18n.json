{
  "Vue3 i18n Setup": {
    "prefix": "v3i18n",
    "body": [
      "import { createI18n } from 'vue-i18n'",
      "",
      "const messages = {",
      "\ten: {",
      "\t\t${1:key}: '${2:value}'",
      "\t},",
      "\tzh: {",
      "\t\t${1:key}: '${3:value}'",
      "\t}",
      "}",
      "",
      "const i18n = createI18n({",
      "\tlocale: 'zh',",
      "\tfallbackLocale: 'en',",
      "\tmessages",
      "})",
      "",
      "export default i18n"
    ],
    "description": "Create Vue I18n instance"
  },
  "Vue3 useI18n": {
    "prefix": "v3usei18n",
    "body": [
      "const { t, locale } = useI18n()",
      "",
      "// Toggle language",
      "function toggleLocale() {",
      "\tlocale.value = locale.value === 'en' ? 'zh' : 'en'",
      "}"
    ],
    "description": "Use Vue I18n Composition API"
  }
} 