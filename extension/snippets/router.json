{
  "Vue3 Router Setup": {
    "prefix": "v3router",
    "body": [
      "import { createRouter, createWebHistory } from 'vue-router'",
      "",
      "const routes = [",
      "\t{",
      "\t\tpath: '/',",
      "\t\tname: 'Home',",
      "\t\tcomponent: () => import('./views/Home.vue')",
      "\t},",
      "\t{",
      "\t\tpath: '/${1:path}',",
      "\t\tname: '${2:name}',",
      "\t\tcomponent: () => import('./views/${3:component}.vue')",
      "\t}",
      "]",
      "",
      "const router = createRouter({",
      "\thistory: createWebHistory(),",
      "\troutes",
      "})",
      "",
      "export default router"
    ],
    "description": "Create Vue Router instance"
  },
  "Vue3 Router Guard": {
    "prefix": "v3guard",
    "body": [
      "router.beforeEach(async (to, from) => {",
      "\t// Check authentication",
      "\tif (to.meta.requiresAuth && !isAuthenticated()) {",
      "\t\t// Redirect to login page",
      "\t\treturn { name: 'Login', query: { redirect: to.fullPath } }",
      "\t}",
      "})"
    ],
    "description": "Add Vue Router navigation guard"
  },
  "Vue3 useRouter": {
    "prefix": "v3userouter",
    "body": [
      "const router = useRouter()",
      "const route = useRoute()",
      "",
      "function ${1:navigate}() {",
      "\trouter.push({",
      "\t\tname: '${2:RouteName}',",
      "\t\tparams: { ${3:id}: ${4:value} }",
      "\t})",
      "}"
    ],
    "description": "Use Vue Router Composition API"
  }
} 