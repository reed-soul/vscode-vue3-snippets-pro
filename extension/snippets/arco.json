{
  "Vue3 Arco Search Table": {
    "prefix": "v3arco-search-table",
    "body": [
      "<script setup lang=\"ts\">",
      "import { ref, reactive } from 'vue'",
      "",
      "interface SearchForm {",
      "\tkeyword: string",
      "\tstatus: string | null",
      "\tdateRange: string[]",
      "}",
      "",
      "const searchForm = reactive<SearchForm>({",
      "\tkeyword: '',",
      "\tstatus: null,",
      "\tdateRange: []",
      "})",
      "",
      "const loading = ref(false)",
      "const data = ref([])",
      "",
      "const columns = [",
      "\t{",
      "\t\ttitle: 'ID',",
      "\t\tdataIndex: 'id'",
      "\t},",
      "\t{",
      "\t\ttitle: 'Name',",
      "\t\tdataIndex: 'name'",
      "\t},",
      "\t{",
      "\t\ttitle: 'Status',",
      "\t\tdataIndex: 'status',",
      "\t\trender: ({ record }) => (",
      "\t\t\t<a-tag color={record.status === '1' ? 'green' : 'red'}>",
      "\t\t\t\t{record.status === '1' ? 'Active' : 'Disabled'}",
      "\t\t\t</a-tag>",
      "\t\t)",
      "\t},",
      "\t{",
      "\t\ttitle: 'Actions',",
      "\t\twidth: 150,",
      "\t\trender: ({ record }) => (",
      "\t\t\t<a-space>",
      "\t\t\t\t<a-button type=\"text\" onClick={() => handleEdit(record)}>",
      "\t\t\t\t\tEdit",
      "\t\t\t\t</a-button>",
      "\t\t\t\t<a-button type=\"text\" status=\"danger\" onClick={() => handleDelete(record)}>",
      "\t\t\t\t\tDelete",
      "\t\t\t\t</a-button>",
      "\t\t\t</a-space>",
      "\t\t)",
      "\t}",
      "]",
      "",
      "const pagination = reactive({",
      "\ttotal: 0,",
      "\tcurrent: 1,",
      "\tpageSize: 10",
      "})",
      "",
      "const handleSearch = async () => {",
      "\ttry {",
      "\t\tloading.value = true",
      "\t\tconst { data: res, total } = await fetchData({",
      "\t\t\t...searchForm,",
      "\t\t\tpage: pagination.current,",
      "\t\t\tpageSize: pagination.pageSize",
      "\t\t})",
      "\t\tdata.value = res",
      "\t\tpagination.total = total",
      "\t} finally {",
      "\t\tloading.value = false",
      "\t}",
      "}",
      "",
      "const handleReset = () => {",
      "\tsearchForm.keyword = ''",
      "\tsearchForm.status = null",
      "\tsearchForm.dateRange = []",
      "\tpagination.current = 1",
      "\thandleSearch()",
      "}",
      "",
      "const handlePageChange = (current: number) => {",
      "\tpagination.current = current",
      "\thandleSearch()",
      "}",
      "</script>",
      "",
      "<template>",
      "\t<div class=\"search-table-container\">",
      "\t\t<a-card>",
      "\t\t\t<!-- Search Form -->",
      "\t\t\t<a-form :model=\"searchForm\" layout=\"inline\">",
      "\t\t\t\t<a-form-item field=\"keyword\" label=\"Keyword\">",
      "\t\t\t\t\t<a-input",
      "\t\t\t\t\t\tv-model=\"searchForm.keyword\"",
      "\t\t\t\t\t\tplaceholder=\"Please enter keyword\"",
      "\t\t\t\t\t\tallow-clear",
      "\t\t\t\t\t\t@press-enter=\"handleSearch\"",
      "\t\t\t\t\t/>",
      "\t\t\t\t</a-form-item>",
      "",
      "\t\t\t\t<a-form-item field=\"status\" label=\"Status\">",
      "\t\t\t\t\t<a-select",
      "\t\t\t\t\t\tv-model=\"searchForm.status\"",
      "\t\t\t\t\t\tplaceholder=\"Please select status\"",
      "\t\t\t\t\t\tallow-clear",
      "\t\t\t\t\t\tstyle=\"width: 120px\"",
      "\t\t\t\t\t>",
      "\t\t\t\t\t\t<a-option value=\"1\">Active</a-option>",
      "\t\t\t\t\t\t<a-option value=\"0\">Disabled</a-option>",
      "\t\t\t\t\t</a-select>",
      "\t\t\t\t</a-form-item>",
      "",
      "\t\t\t\t<a-form-item field=\"dateRange\" label=\"Date Range\">",
      "\t\t\t\t\t<a-range-picker",
      "\t\t\t\t\t\tv-model=\"searchForm.dateRange\"",
      "\t\t\t\t\t\tstyle=\"width: 240px\"",
      "\t\t\t\t\t/>",
      "\t\t\t\t</a-form-item>",
      "",
      "\t\t\t\t<a-form-item>",
      "\t\t\t\t\t<a-space>",
      "\t\t\t\t\t\t<a-button type=\"primary\" @click=\"handleSearch\">",
      "\t\t\t\t\t\t\tSearch",
      "\t\t\t\t\t\t</a-button>",
      "\t\t\t\t\t\t<a-button @click=\"handleReset\">Reset</a-button>",
      "\t\t\t\t\t</a-space>",
      "\t\t\t\t</a-form-item>",
      "\t\t\t</a-form>",
      "",
      "\t\t\t<!-- Table -->",
      "\t\t\t<a-table",
      "\t\t\t\t:columns=\"columns\"",
      "\t\t\t\t:data=\"data\"",
      "\t\t\t\t:loading=\"loading\"",
      "\t\t\t\t:pagination=\"pagination\"",
      "\t\t\t\t@page-change=\"handlePageChange\"",
      "\t\t\t/>",
      "\t\t</a-card>",
      "\t</div>",
      "</template>",
      "",
      "<style scoped>",
      ".search-table-container {",
      "\tpadding: 24px;",
      "}",
      "",
      ".arco-form {",
      "\tmargin-bottom: 24px;",
      "}",
      "</style>"
    ],
    "description": "Arco Design Vue Search Table Component"
  }
} 