{
  "Vue3 Naive Search Table": {
    "prefix": "v3n-search-table",
    "body": [
      "<script setup lang=\"ts\">",
      "// Docs: https://www.naiveui.com/en-US/os-theme/components/data-table",
      "import { h, ref, reactive } from 'vue'",
      "import type { DataTableColumns } from 'naive-ui'",
      "import { NButton, NTag, useMessage } from 'naive-ui'",
      "",
      "interface RowData {",
      "\tid: number",
      "\tname: string",
      "\tstatus: string",
      "\tdate: string",
      "}",
      "",
      "const searchForm = reactive({",
      "\tkeyword: '',",
      "\tstatus: null as null | string,",
      "\tdateRange: null as null | [number, number]",
      "})",
      "",
      "const message = useMessage()",
      "const loading = ref(false)",
      "const data = ref<RowData[]>([])",
      "const pagination = reactive({",
      "\tpage: 1,",
      "\tpageSize: 10,",
      "\tshowSizePicker: true,",
      "\tpageCount: 1,",
      "\tpageSizes: [10, 20, 30, 40]",
      "})",
      "",
      "const columns: DataTableColumns<RowData> = [",
      "\t{ title: 'ID', key: 'id' },",
      "\t{ title: 'Name', key: 'name' },",
      "\t{",
      "\t\ttitle: 'Status',",
      "\t\tkey: 'status',",
      "\t\trender(row) {",
      "\t\t\treturn h(",
      "\t\t\t\tNTag,",
      "\t\t\t\t{ type: row.status === '1' ? 'success' : 'warning', size: 'small' },",
      "\t\t\t\t{ default: () => (row.status === '1' ? 'Active' : 'Disabled') }",
      "\t\t\t)",
      "\t\t}",
      "\t},",
      "\t{",
      "\t\ttitle: 'Actions',",
      "\t\tkey: 'actions',",
      "\t\trender(row) {",
      "\t\t\treturn [",
      "\t\t\t\th(",
      "\t\t\t\t\tNButton,",
      "\t\t\t\t\t{",
      "\t\t\t\t\t\ttext: true,",
      "\t\t\t\t\t\ttype: 'primary',",
      "\t\t\t\t\t\tonClick: () => handleEdit(row)",
      "\t\t\t\t\t},",
      "\t\t\t\t\t{ default: () => 'Edit' }",
      "\t\t\t\t),",
      "\t\t\t\th(",
      "\t\t\t\t\tNButton,",
      "\t\t\t\t\t{",
      "\t\t\t\t\t\ttext: true,",
      "\t\t\t\t\t\ttype: 'error',",
      "\t\t\t\t\t\tonClick: () => handleDelete(row)",
      "\t\t\t\t\t},",
      "\t\t\t\t\t{ default: () => 'Delete' }",
      "\t\t\t\t)",
      "\t\t\t]",
      "\t\t}",
      "\t}",
      "]",
      "",
      "const handleSearch = async () => {",
      "\ttry {",
      "\t\tloading.value = true",
      "\t\tconst { data: res, total } = await fetchData({",
      "\t\t\t...searchForm,",
      "\t\t\tpage: pagination.page,",
      "\t\t\tpageSize: pagination.pageSize",
      "\t\t})",
      "\t\tdata.value = res",
      "\t\tpagination.pageCount = Math.ceil(total / pagination.pageSize)",
      "\t} finally {",
      "\t\tloading.value = false",
      "\t}",
      "}",
      "",
      "const handleReset = () => {",
      "\tsearchForm.keyword = ''",
      "\tsearchForm.status = null",
      "\tsearchForm.dateRange = null",
      "\tpagination.page = 1",
      "\thandleSearch()",
      "}",
      "",
      "const handlePageChange = (page: number) => {",
      "\tpagination.page = page",
      "\thandleSearch()",
      "}",
      "",
      "const handlePageSizeChange = (pageSize: number) => {",
      "\tpagination.pageSize = pageSize",
      "\tpagination.page = 1",
      "\thandleSearch()",
      "}",
      "",
      "const handleEdit = (row: RowData) => {",
      "\tmessage.info(`Edit ${'$'}{row.name}`)",
      "}",
      "",
      "const handleDelete = (row: RowData) => {",
      "\tmessage.warning(`Delete ${'$'}{row.name}`)",
      "}",
      "</script>",
      "",
      "<template>",
      "\t<div class=\"search-table-container\">",
      "\t\t<n-card>",
      "\t\t\t<!-- Search Form -->",
      "\t\t\t<n-space vertical :size=\"24\">",
      "\t\t\t\t<n-form inline :model=\"searchForm\">",
      "\t\t\t\t\t<n-form-item label=\"Keyword\">",
      "\t\t\t\t\t\t<n-input",
      "\t\t\t\t\t\t\tv-model:value=\"searchForm.keyword\"",
      "\t\t\t\t\t\t\tplaceholder=\"Please enter keyword\"",
      "\t\t\t\t\t\t\tclearable",
      "\t\t\t\t\t\t\t@keyup.enter=\"handleSearch\"",
      "\t\t\t\t\t\t/>",
      "\t\t\t\t\t</n-form-item>",
      "",
      "\t\t\t\t\t<n-form-item label=\"Status\">",
      "\t\t\t\t\t\t<n-select",
      "\t\t\t\t\t\t\tv-model:value=\"searchForm.status\"",
      "\t\t\t\t\t\t\t:options=\"[",
      "\t\t\t\t\t\t\t\t{ label: 'Active', value: '1' },",
      "\t\t\t\t\t\t\t\t{ label: 'Disabled', value: '0' }",
      "\t\t\t\t\t\t\t]\"",
      "\t\t\t\t\t\t\tclearable",
      "\t\t\t\t\t\t\tplaceholder=\"Please select status\"",
      "\t\t\t\t\t\t\tstyle=\"width: 120px\"",
      "\t\t\t\t\t\t/>",
      "\t\t\t\t\t</n-form-item>",
      "",
      "\t\t\t\t\t<n-form-item label=\"Date Range\">",
      "\t\t\t\t\t\t<n-date-picker",
      "\t\t\t\t\t\t\tv-model:value=\"searchForm.dateRange\"",
      "\t\t\t\t\t\t\ttype=\"daterange\"",
      "\t\t\t\t\t\t\tclearable",
      "\t\t\t\t\t\t\tstyle=\"width: 240px\"",
      "\t\t\t\t\t\t/>",
      "\t\t\t\t\t</n-form-item>",
      "",
      "\t\t\t\t\t<n-form-item>",
      "\t\t\t\t\t\t<n-space>",
      "\t\t\t\t\t\t\t<n-button type=\"primary\" @click=\"handleSearch\">",
      "\t\t\t\t\t\t\t\tSearch",
      "\t\t\t\t\t\t\t</n-button>",
      "\t\t\t\t\t\t\t<n-button @click=\"handleReset\">Reset</n-button>",
      "\t\t\t\t\t\t</n-space>",
      "\t\t\t\t\t</n-form-item>",
      "\t\t\t\t</n-form>",
      "",
      "\t\t\t\t<!-- Table -->",
      "\t\t\t\t<n-data-table",
      "\t\t\t\t\t:columns=\"columns\"",
      "\t\t\t\t\t:data=\"data\"",
      "\t\t\t\t\t:loading=\"loading\"",
      "\t\t\t\t\t:pagination=\"pagination\"",
      "\t\t\t\t\t@update:page=\"handlePageChange\"",
      "\t\t\t\t\t@update:page-size=\"handlePageSizeChange\"",
      "\t\t\t\t/>",
      "\t\t\t</n-space>",
      "\t\t</n-card>",
      "\t</div>",
      "</template>",
      "",
      "<style scoped>",
      ".search-table-container {",
      "\tpadding: 24px;",
      "}",
      "</style>"
    ],
    "description": "Naive UI Search Table Component"
  }
} 